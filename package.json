{
    "name": "susdock",
    "kernelsu": {
        "name": "SusDock",
        "updateJson": "https://raw.githubusercontent.com/Nixie24/susfs4ksu-lkm-module/update/update.json"
    },
    "type": "module",
    "version": "0.2.1",
    "private": true,
    "packageManager": "pnpm@12.11.2",
    "description": "A SuSFS Manager for LKM Setups",
    "author": {
        "name": "Nix24",
        "email": "nix24nya@gmail.com",
        "url": "https://nixy.ing"
    },
    "license": "GPL-2.0-only",
    "scripts": {
        "dev": "pnpm --filter webui run dev",
        "build": "pnpm --filter webui run build && pnpm --filter module run build",
        "module:build": "pnpm --filter module run build",
        "webui:build": "pnpm --filter webui run build",
        "lint": "eslint",
        "sync": "syncpack"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.11.2",
            "onFail": "download"
        }
    },
    "devDependencies": {
        "@antfu/eslint-config": "9.5.1",
        "@types/node": "26.4.0",
        "commitfmt": "^1.3.0",
        "eslint": "10.12.0",
        "eslint-plugin-format": "2.0.1",
        "jiti": "2.7.0",
        "prettier-plugin-css-order": "2.2.0",
        "prettier-plugin-sh": "0.20.2",
        "syncpack": "15.3.3",
        "typescript": "6.0.3"
    }
}
